{"remainingRequest":"D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\node_modules\\babel-loader\\lib\\index.js!D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\node_modules\\cache-loader\\dist\\cjs.js??ref--1-0!D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\node_modules\\vue-loader\\lib\\index.js??vue-loader-options!D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\src\\components\\common\\Carousel.vue?vue&type=script&lang=js","dependencies":[{"path":"D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\src\\components\\common\\Carousel.vue","mtime":1778221340940},{"path":"D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1775472968682},{"path":"D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\node_modules\\babel-loader\\lib\\index.js","mtime":1775472968751},{"path":"D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\node_modules\\cache-loader\\dist\\cjs.js","mtime":1775472968682},{"path":"D:\\AgricultureAidSystem\\AgricultureAidSystem-main\\2.VueAdmin\\node_modules\\vue-loader\\lib\\index.js","mtime":1775472967752}],"contextDependencies":[],"result":[{"type":"Buffer","data":"base64:"},{"version":3,"names":["name","data","carouselData","defaultImages","mounted","$nextTick","getCarouselData","methods","carouselImgSrc","item","v","value","String","trim","startsWith","indexOf","$base","url","replace","handleImageError","index","length","$http","method","params","limit","then","code","list","filter","setDefaultCarousel","catch","err","console","error","map","img","id"],"sources":["src/components/common/Carousel.vue"],"sourcesContent":["<template>\n  <div class=\"carousel-container\">\n    <el-carousel :style='{\"width\":\"100%\",\"margin\":\"0 auto\"}' trigger=\"click\" indicator-position=\"bottom\" arrow=\"hover\" type=\"default\" height=\"400px\" :autoplay=\"true\" :interval=\"5000\" :loop=\"true\">\n      <el-carousel-item :style='{\"width\":\"100%\",\"height\":\"100%\"}' v-for=\"(item, index) in carouselData\" :key=\"index\">\n        <div class=\"carousel-item-wrapper\">\n          <img :src=\"carouselImgSrc(item)\" alt=\"轮播图\" class=\"carousel-image\" @error=\"handleImageError(index)\">\n          <div class=\"carousel-overlay\">\n            <div class=\"carousel-content\">\n              <div class=\"carousel-tag\">\n                <i class=\"el-icon-s-marketing\"></i>\n                助农平台\n              </div>\n              <div class=\"carousel-title\">{{ item.title || '让每一份农产品都能被看见' }}</div>\n              <div class=\"carousel-desc\">{{ item.description || '连接乡村与城市，传递绿色与希望' }}</div>\n            </div>\n          </div>\n        </div>\n      </el-carousel-item>\n    </el-carousel>\n  </div>\n</template>\n\n<script>\nexport default {\n  name: 'Carousel',\n  data() {\n    return {\n      carouselData: [],\n      defaultImages: [\n        'https://neeko-copilot.bytedance.net/api/text_to_image?prompt=beautiful%20agricultural%20landscape%20with%20green%20fields%20golden%20wheat%20and%20blue%20sky%20with%20sunlight&image_size=landscape_16_9',\n        'https://neeko-copilot.bytedance.net/api/text_to_image?prompt=fresh%20organic%20farm%20products%20vegetables%20fruits%20on%20wooden%20table%20with%20natural%20light&image_size=landscape_16_9',\n        'https://neeko-copilot.bytedance.net/api/text_to_image?prompt=modern%20greenhouse%20agriculture%20technology%20with%20plants%20growing%20under%20LED%20lights&image_size=landscape_16_9'\n      ]\n    }\n  },\n  mounted() {\n    this.$nextTick(() => {\n      this.getCarouselData();\n    });\n  },\n  methods: {\n    carouselImgSrc(item) {\n      const v = (item && item.value ? String(item.value) : \"\").trim();\n      if (!v) {\n        return \"\";\n      }\n      if (v.startsWith(\"http://\") || v.startsWith(\"https://\")) {\n        return v;\n      }\n      if (v.indexOf('upload/') !== -1) {\n        return this.$base.url + v.replace(/^\\//, \"\");\n      }\n      return this.$base.url + 'upload/' + v.replace(/^\\//, \"\");\n    },\n    handleImageError(index) {\n      if (this.carouselData[index]) {\n        this.carouselData[index].value = this.defaultImages[index % this.defaultImages.length];\n      }\n    },\n    getCarouselData() {\n      this.$http({\n        url: \"config/list\",\n        method: \"get\",\n        params: {\n          limit: 10\n        }\n      }).then(({ data }) => {\n        if (data && data.code === 0 && data.data && data.data.list && data.data.list.length > 0) {\n          this.carouselData = data.data.list.filter(item => item.value && item.value.trim() !== '');\n        } else {\n          this.setDefaultCarousel();\n        }\n      }).catch(err => {\n        console.error('轮播图数据获取失败:', err);\n        this.setDefaultCarousel();\n      });\n    },\n    setDefaultCarousel() {\n      this.carouselData = this.defaultImages.map((img, index) => ({\n        value: img,\n        id: index\n      }));\n    }\n  }\n}\n</script>\n\n<style scoped>\n.carousel-container {\n  width: 100%;\n  margin-bottom: 20px;\n  border-radius: 16px;\n  overflow: hidden;\n}\n\n.carousel-item-wrapper {\n  position: relative;\n  width: 100%;\n  height: 100%;\n  border-radius: 16px;\n  overflow: hidden;\n}\n\n.carousel-image {\n  width: 100%;\n  height: 100%;\n  object-fit: cover;\n  transition: transform 0.6s ease;\n}\n\n.carousel-item-wrapper:hover .carousel-image {\n  transform: scale(1.05);\n}\n\n.carousel-overlay {\n  position: absolute;\n  bottom: 0;\n  left: 0;\n  right: 0;\n  background: linear-gradient(transparent, rgba(0, 0, 0, 0.6));\n  padding: 50px 40px 30px;\n}\n\n.carousel-content {\n  max-width: 800px;\n}\n\n.carousel-tag {\n  display: inline-flex;\n  align-items: center;\n  background: rgba(102, 187, 106, 0.9);\n  color: #fff;\n  padding: 6px 16px;\n  border-radius: 20px;\n  font-size: 12px;\n  margin-bottom: 16px;\n  font-weight: 500;\n}\n\n.carousel-tag i {\n  margin-right: 6px;\n}\n\n.carousel-title {\n  color: #fff;\n  font-size: 28px;\n  font-weight: 600;\n  margin-bottom: 12px;\n  text-shadow: 0 2px 10px rgba(0, 0, 0, 0.3);\n}\n\n.carousel-desc {\n  color: rgba(255, 255, 255, 0.85);\n  font-size: 15px;\n  line-height: 1.6;\n}\n\n:deep(.el-carousel__indicator) {\n  background: rgba(255, 255, 255, 0.4);\n  width: 12px;\n  height: 12px;\n  border-radius: 50%;\n}\n\n:deep(.el-carousel__indicator.is-active) {\n  background: #66bb6a;\n  width: 32px;\n  border-radius: 6px;\n}\n\n:deep(.el-carousel__arrow) {\n  width: 44px;\n  height: 44px;\n  background: rgba(255, 255, 255, 0.2);\n  border-radius: 50%;\n  margin: 0 20px;\n}\n\n:deep(.el-carousel__arrow:hover) {\n  background: rgba(102, 187, 106, 0.8);\n}\n\n:deep(.el-carousel__arrow) i {\n  font-size: 20px;\n}\n</style>\n"],"mappings":"AAuBA;EACAA,IAAA;EACAC,KAAA;IACA;MACAC,YAAA;MACAC,aAAA,GACA,6MACA,iMACA;IAEA;EACA;EACAC,QAAA;IACA,KAAAC,SAAA;MACA,KAAAC,eAAA;IACA;EACA;EACAC,OAAA;IACAC,eAAAC,IAAA;MACA,MAAAC,CAAA,IAAAD,IAAA,IAAAA,IAAA,CAAAE,KAAA,GAAAC,MAAA,CAAAH,IAAA,CAAAE,KAAA,QAAAE,IAAA;MACA,KAAAH,CAAA;QACA;MACA;MACA,IAAAA,CAAA,CAAAI,UAAA,eAAAJ,CAAA,CAAAI,UAAA;QACA,OAAAJ,CAAA;MACA;MACA,IAAAA,CAAA,CAAAK,OAAA;QACA,YAAAC,KAAA,CAAAC,GAAA,GAAAP,CAAA,CAAAQ,OAAA;MACA;MACA,YAAAF,KAAA,CAAAC,GAAA,eAAAP,CAAA,CAAAQ,OAAA;IACA;IACAC,iBAAAC,KAAA;MACA,SAAAlB,YAAA,CAAAkB,KAAA;QACA,KAAAlB,YAAA,CAAAkB,KAAA,EAAAT,KAAA,QAAAR,aAAA,CAAAiB,KAAA,QAAAjB,aAAA,CAAAkB,MAAA;MACA;IACA;IACAf,gBAAA;MACA,KAAAgB,KAAA;QACAL,GAAA;QACAM,MAAA;QACAC,MAAA;UACAC,KAAA;QACA;MACA,GAAAC,IAAA;QAAAzB;MAAA;QACA,IAAAA,IAAA,IAAAA,IAAA,CAAA0B,IAAA,UAAA1B,IAAA,CAAAA,IAAA,IAAAA,IAAA,CAAAA,IAAA,CAAA2B,IAAA,IAAA3B,IAAA,CAAAA,IAAA,CAAA2B,IAAA,CAAAP,MAAA;UACA,KAAAnB,YAAA,GAAAD,IAAA,CAAAA,IAAA,CAAA2B,IAAA,CAAAC,MAAA,CAAApB,IAAA,IAAAA,IAAA,CAAAE,KAAA,IAAAF,IAAA,CAAAE,KAAA,CAAAE,IAAA;QACA;UACA,KAAAiB,kBAAA;QACA;MACA,GAAAC,KAAA,CAAAC,GAAA;QACAC,OAAA,CAAAC,KAAA,eAAAF,GAAA;QACA,KAAAF,kBAAA;MACA;IACA;IACAA,mBAAA;MACA,KAAA5B,YA